{
  "name": "diaporia-safebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test",
    "test:contract": "cargo test --manifest-path contract/Cargo.toml",
    "build:contract": "cargo build --manifest-path contract/Cargo.toml --release --target wasm32-unknown-unknown",
    "demo": "node demo/mock-flow.mjs",
    "demo:v1": "node --disable-warning=ExperimentalWarning demo/offline-v1.mjs",
    "demo:testnet": "node --disable-warning=ExperimentalWarning demo/testnet-v1.mjs",
    "evidence": "SAFEBOX_WRITE_EVIDENCE=1 node --disable-warning=ExperimentalWarning --test tests/v1/adversarial.test.mjs",
    "vectors": "node scripts/gen-contract-vectors.mjs",
    "v2:test": "node --disable-warning=ExperimentalWarning --test tests/v2/*.test.mjs",
    "v2:holdout": "node --disable-warning=ExperimentalWarning scripts/v2/holdout.mjs",
    "v2:os": "node --disable-warning=ExperimentalWarning scripts/v2/run-isolated.mjs",
    "v2:evaluate": "node --disable-warning=ExperimentalWarning scripts/v2/evaluate.mjs",
    "v3:test": "node --disable-warning=ExperimentalWarning --test tests/v3/*.test.mjs",
    "test:contract-v3": "cargo test --manifest-path contract-v3/Cargo.toml",
    "build:contract-v3": "cargo build --manifest-path contract-v3/Cargo.toml --release --target wasm32-unknown-unknown",
    "v3:os": "node scripts/v3/os-matrix.mjs",
    "v3:check-deployment": "node scripts/v3/check-deployment.mjs",
    "v3:redteam": "node --disable-warning=ExperimentalWarning scripts/v3/run-redteam.mjs",
    "v4:test": "node --disable-warning=ExperimentalWarning --test tests/v4/*.test.mjs",
    "test:contract-v4": "cargo test --manifest-path contract-v4/Cargo.toml",
    "build:contract-v4": "cargo build --manifest-path contract-v4/Cargo.toml --release --target wasm32-unknown-unknown",
    "v4:matrix": "node --disable-warning=ExperimentalWarning scripts/v4/recovery-matrix.mjs",
    "v4:redteam": "node --disable-warning=ExperimentalWarning scripts/v4/run-redteam.mjs",
    "v4:os": "node scripts/v4/os-matrix.mjs",
    "v4:mutations": "node scripts/v4/mutations.mjs",
    "v5:test": "node --disable-warning=ExperimentalWarning --test tests/v5/*.test.mjs",
    "v5:scenarios": "node --disable-warning=ExperimentalWarning scripts/v5/run-scenarios.mjs",
    "v5:redteam": "node --disable-warning=ExperimentalWarning scripts/v5/run-redteam.mjs",
    "v5:mutations": "node --disable-warning=ExperimentalWarning scripts/v5/mutations.mjs"
  },
  "dependencies": {
    "near-api-js": "7.5.3"
  }
}
